generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
}

// ==========================================
// Administrateurs (table séparée)
// ==========================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

model Admin {
  id                String    @id @default(uuid())
  email             String    @unique
  fullName          String?   @map("full_name")
  password          String
  phone             String?
  avatar            String?
  role              AdminRole @default(ADMIN)
  isActive          Boolean   @default(true) @map("is_active")
  resetToken        String?   @unique @map("reset_token")
  resetExpires      DateTime? @map("reset_expires")
  passwordChangedAt DateTime? @map("password_changed_at")
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

// ==========================================
// Journal d'activité admin
// ==========================================

model ActivityLog {
  id         String   @id @default(uuid())
  adminId    String?  @map("admin_id")
  adminEmail String?  @map("admin_email")
  adminRole  String?  @map("admin_role")
  action     String
  entity     String?
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  fullName          String?   @map("full_name")
  password          String?
  phone             String?
  avatar            String?
  role              Role      @default(USER)
  isEmailVerified   Boolean   @default(false) @map("is_email_verified")
  isActive          Boolean   @default(false) @map("is_active")
  activationToken   String?   @unique @map("activation_token")
  activationExpires DateTime? @map("activation_expires")
  resetToken        String?   @unique @map("reset_token")
  resetExpires      DateTime? @map("reset_expires")
  passwordChangedAt DateTime? @map("password_changed_at")
  loginToken        String?   @unique @map("login_token")
  loginTokenExpires DateTime? @map("login_token_expires")
  googleId          String?   @unique @map("google_id")
  facebookId        String?   @unique @map("facebook_id")
  oauthProvider     String?   @map("oauth_provider")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  reviews           Review[]
  addresses         Address[]
  notifications     Notification[]

  @@map("users")
}

// ==========================================
// Adresses de livraison
// ==========================================

model Address {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  fullName    String   @map("full_name")
  phone       String?
  street      String
  city        String
  postalCode  String?  @map("postal_code")
  country     String   @default("Bénin")
  isDefault   Boolean  @default(false) @map("is_default")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

// ==========================================
// Catégories
// ==========================================

model Category {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  description   String?
  icon          String?
  image         String?
  position      Int           @default(0)
  isActive      Boolean       @default(true) @map("is_active")

  subCategories SubCategory[]

  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([slug])
  @@map("categories")
}

model SubCategory {
  id          String    @id @default(uuid())
  categoryId  String    @map("category_id")
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  position    Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([slug])
  @@map("sub_categories")
}

// ==========================================
// Produits
// ==========================================

enum ProductCondition {
  NEW
  REFURBISHED
  USED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Product {
  id               String           @id @default(uuid())

  name             String
  slug             String           @unique
  shortDescription String?          @map("short_description")
  description      String?
  category         String?
  subCategory      String?          @map("sub_category")
  brand            String?
  condition        ProductCondition @default(NEW)
  warranty         String?
  originCountry    String?          @map("origin_country")

  sku              String?
  barcode          String?
  price            Decimal          @db.Decimal(12, 2)
  comparePrice     Decimal?         @map("compare_price") @db.Decimal(12, 2)
  cost             Decimal?         @db.Decimal(12, 2)
  taxRate          Decimal          @default(20) @map("tax_rate") @db.Decimal(5, 2)
  stock            Int              @default(0)
  lowStockThreshold Int             @default(10) @map("low_stock_threshold")
  trackInventory   Boolean          @default(true) @map("track_inventory")
  allowBackorder   Boolean          @default(false) @map("allow_backorder")

  weight           Decimal?         @db.Decimal(10, 2)
  dimensionLength  Decimal?         @map("dimension_length") @db.Decimal(10, 2)
  dimensionWidth   Decimal?         @map("dimension_width") @db.Decimal(10, 2)
  dimensionHeight  Decimal?         @map("dimension_height") @db.Decimal(10, 2)

  discountPrice    Decimal?         @map("discount_price") @db.Decimal(12, 2)
  discountStartAt  DateTime?        @map("discount_start_at")
  discountEndAt    DateTime?        @map("discount_end_at")

  tags             String[]         @default([])
  status           ProductStatus    @default(DRAFT)
  isFeatured       Boolean          @default(false) @map("is_featured")

  images           ProductImage[]
  videos           ProductVideo[]
  variants         ProductVariant[]
  reviews          Review[]

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([slug])
  @@index([category])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  features  ImageFeatures?

  @@index([productId])
  @@map("product_images")
}

model ImageFeatures {
  id             String       @id @default(uuid())
  productImageId String       @unique @map("product_image_id")
  productImage   ProductImage @relation(fields: [productImageId], references: [id], onDelete: Cascade)
  features       Json
  modelVersion   String       @default("mobilenet-v2") @map("model_version")

  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("image_features")
}

model ProductVideo {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  source    String  @default("upload")
  thumbnail String?
  title     String?
  position  Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_videos")
}

model ProductVariant {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  combination Json
  price       Decimal @db.Decimal(12, 2)
  stock       Int     @default(0)
  sku         String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

// ==========================================
// Avis
// ==========================================

model Review {
  id         String  @id @default(uuid())
  productId  String  @map("product_id")
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String  @map("user_id")
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  title      String?
  content    String?
  isVerified Boolean @default(false) @map("is_verified")
  helpful    Int     @default(0)

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

// ==========================================
// Commandes
// ==========================================

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  MOBILE_MONEY
  CARD
  FEEXPAY_WALLET
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique @map("order_number")
  userId            String?       @map("user_id")

  customerEmail     String        @map("customer_email")
  customerFirstName String        @map("customer_first_name")
  customerLastName  String        @map("customer_last_name")
  customerPhone     String        @map("customer_phone")

  shippingAddress   String        @map("shipping_address")
  shippingCity      String        @map("shipping_city")
  shippingCountry   String        @map("shipping_country")
  shippingNotes     String?       @map("shipping_notes")

  subtotal          Decimal       @db.Decimal(12, 2)
  shippingCost      Decimal       @map("shipping_cost") @db.Decimal(12, 2)
  tax               Decimal       @default(0) @db.Decimal(12, 2)
  discount          Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  currency          String        @default("XOF")

  paymentMethod     PaymentMethod @map("payment_method")
  paymentProvider   String?       @map("payment_provider")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  paymentReference  String?       @map("payment_reference")
  paymentData       Json?         @map("payment_data")
  paidAt            DateTime?     @map("paid_at")

  status            OrderStatus   @default(PENDING)

  items             OrderItem[]

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String  @map("order_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId    String  @map("product_id")

  productName  String  @map("product_name")
  productSlug  String  @map("product_slug")
  productImage String? @map("product_image")

  quantity     Int
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(12, 2)

  variantData  Json?   @map("variant_data")

  createdAt    DateTime @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ==========================================
// Codes Promo
// ==========================================

enum PromoCodeType {
  PERCENTAGE
  FIXED
}

model PromoCode {
  id             String        @id @default(uuid())
  code           String        @unique
  type           PromoCodeType @default(PERCENTAGE)
  value          Decimal       @db.Decimal(10, 2)
  minOrderAmount Decimal?      @map("min_order_amount") @db.Decimal(12, 2)
  maxUses        Int?          @map("max_uses")
  usedCount      Int           @default(0) @map("used_count")
  isActive       Boolean       @default(true) @map("is_active")
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([code])
  @@map("promo_codes")
}

// ==========================================
// Configuration du site
// ==========================================

model SiteSettings {
  id              String   @id @default("default")

  siteName        String   @default("ChezPrecious") @map("site_name")
  siteSlogan      String?  @map("site_slogan")
  siteDescription String?  @map("site_description")
  siteUrl         String?  @map("site_url")
  language        String   @default("fr")
  timezone        String   @default("Africa/Porto-Novo")
  logo            String?
  favicon         String?
  banner          String?

  contactEmail    String?  @map("contact_email")
  supportEmail    String?  @map("support_email")
  noReplyEmail    String?  @map("no_reply_email")
  phoneMain       String?  @map("phone_main")
  phoneWhatsapp   String?  @map("phone_whatsapp")
  phoneSupport    String?  @map("phone_support")
  address         String?
  city            String?
  country         String?
  postalCode      String?  @map("postal_code")
  businessHours   String?  @map("business_hours")

  facebook        String?
  instagram       String?
  twitter         String?
  youtube         String?
  linkedin        String?
  tiktok          String?

  primaryColor    String   @default("#FF2C2C") @map("primary_color")
  secondaryColor  String   @default("#1F1416") @map("secondary_color")
  accentColor     String   @default("#FFFAF7") @map("accent_color")

  currency        String   @default("XOF")
  minOrder        Decimal  @default(0) @map("min_order") @db.Decimal(12, 2)
  freeShippingMin Decimal  @default(50000) @map("free_shipping_min") @db.Decimal(12, 2)
  taxRate         Decimal  @default(18) @map("tax_rate") @db.Decimal(5, 2)
  paymentMethods  Json     @default("[]") @map("payment_methods")

  shippingMethods Json     @default("[]") @map("shipping_methods")

  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  metaKeywords    String?  @map("meta_keywords")
  googleAnalytics String?  @map("google_analytics")
  facebookPixel   String?  @map("facebook_pixel")

  cguContent      String?  @map("cgu_content")
  privacyContent  String?  @map("privacy_content")
  mentionsContent String?  @map("mentions_content")
  returnPolicy    String?  @map("return_policy")

  notifOrders     Boolean  @default(true) @map("notif_orders")
  notifStock      Boolean  @default(true) @map("notif_stock")
  notifEmail      Boolean  @default(true) @map("notif_email")
  notifPush       Boolean  @default(false) @map("notif_push")

  homepageBanners Json?    @map("homepage_banners")
  flashSaleConfig Json?    @map("flash_sale_config")
  adSectionConfig Json?    @map("ad_section_config")

  maintenanceMode   Boolean @default(false) @map("maintenance_mode")
  productModeration Boolean @default(false) @map("product_moderation")
  reviewModeration  Boolean @default(true) @map("review_moderation")

  require2fa        Boolean @default(false) @map("require_2fa")
  lockAfterAttempts Boolean @default(true)  @map("lock_after_attempts")
  sessionTimeout    Boolean @default(true)  @map("session_timeout")
  ipRestriction     Boolean @default(false) @map("ip_restriction")
  advancedLogging   Boolean @default(true)  @map("advanced_logging")
  bruteForceProtect Boolean @default(true)  @map("brute_force_protect")

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// ==========================================
// Newsletter
// ==========================================

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  isActive       Boolean   @default(true) @map("is_active")
  token          String?   @unique
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@index([email])
  @@index([isActive])
  @@map("newsletter_subscribers")
}

enum NewsletterCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

model NewsletterCampaign {
  id          String                   @id @default(uuid())
  subject     String
  body        String                   @db.Text
  adminId     String?                  @map("admin_id")
  status      NewsletterCampaignStatus @default(DRAFT)
  sentAt      DateTime?                @map("sent_at")
  sentCount   Int                      @default(0) @map("sent_count")
  failedCount Int                      @default(0) @map("failed_count")
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  @@index([status])
  @@index([adminId])
  @@map("newsletter_campaigns")
}

// ==========================================
// Messages admin ↔ clients
// ==========================================

model AdminMessage {
  id          String   @id @default(uuid())
  adminId     String   @map("admin_id")
  userId      String   @map("user_id")
  senderRole  String   @default("admin") @map("sender_role")
  body        String

  isReadByAdmin Boolean @default(false) @map("is_read_by_admin")
  isReadByUser  Boolean @default(false) @map("is_read_by_user")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([adminId, userId])
  @@index([userId])
  @@map("admin_messages")
}

// ==========================================
// Notifications
// ==========================================

enum NotificationType {
  ORDER_STATUS
  MESSAGE_NEW
  STOCK_LOW
  SYSTEM
}

model AbandonedCart {
  id                   String    @id @default(uuid())
  email                String
  firstName            String?   @map("first_name")
  userId               String?   @map("user_id")
  cartData             Json      @map("cart_data")
  cartTotal            Decimal   @map("cart_total") @db.Decimal(12, 2)
  itemCount            Int       @map("item_count")
  recoveryToken        String    @unique @map("recovery_token")
  isRecovered          Boolean   @default(false) @map("is_recovered")
  recoveredAt          DateTime? @map("recovered_at")
  firstReminderSentAt  DateTime? @map("first_reminder_sent_at")
  secondReminderSentAt DateTime? @map("second_reminder_sent_at")
  abandonedAt          DateTime  @default(now()) @map("abandoned_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([email])
  @@index([isRecovered, abandonedAt])
  @@index([recoveryToken])
  @@map("abandoned_carts")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  body        String
  isRead      Boolean          @default(false) @map("is_read")

  resourceId  String?          @map("resource_id")
  resourceUrl String?          @map("resource_url")

  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}
