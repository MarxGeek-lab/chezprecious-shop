# Copier en api/.env.production
# NODE_ENV, HOST, PORT, DATABASE_URL et DB_* sont fournis par docker-compose.yml

LOG_LEVEL=info
SESSION_DRIVER=cookie
APP_NAME=ChezPrecious

# openssl rand -hex 32
APP_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=7d
CRON_SECRET=

APP_URL=https://api.chezprecious.com
FRONTEND_URL=https://chezprecious.com
FRONTEND_URL_ADMIN=https://admin.chezprecious.com

# SMTP
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ChezPrecious <contact@chezprecious.com>

# OAuth Google (callback à déclarer dans la Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.chezprecious.com/api/auth/oauth/google/callback

# OAuth Facebook (optionnel)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://api.chezprecious.com/api/auth/oauth/facebook/callback
